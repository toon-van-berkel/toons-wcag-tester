{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/toon-van-berkel/toons-wcag-tester/main/config/schema.json",
    "title": "WCAG Tester Configuration",
    "description": "Configuration schema for toons-wcag-tester.",
    "type": "object",
    "additionalProperties": false,

    "properties": {
        "$schema": {
            "type": "string"
        },

        "version": {
            "type": "integer",
            "const": 1,
            "default": 1
        },

        "enabled": {
            "type": "boolean",
            "description": "Enable or disable the WCAG audit.",
            "default": true
        },

        "target": {
            "type": "string",
            "description": "Target WCAG 2.2 conformance level.",
            "enum": ["A", "AA", "AAA"],
            "default": "AAA"
        },

        "principles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "perceivable": {
                    "$ref": "#/$defs/toggle"
                },
                "operable": {
                    "$ref": "#/$defs/toggle"
                },
                "understandable": {
                    "$ref": "#/$defs/toggle"
                },
                "robust": {
                    "$ref": "#/$defs/toggle"
                }
            }
        },

        "categories": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "text-alternatives": {
                    "$ref": "#/$defs/toggle"
                },
                "time-based-media": {
                    "$ref": "#/$defs/toggle"
                },
                "adaptable": {
                    "$ref": "#/$defs/toggle"
                },
                "distinguishable": {
                    "$ref": "#/$defs/toggle"
                },
                "keyboard-accessible": {
                    "$ref": "#/$defs/toggle"
                },
                "enough-time": {
                    "$ref": "#/$defs/toggle"
                },
                "seizures-and-physical-reactions": {
                    "$ref": "#/$defs/toggle"
                },
                "navigable": {
                    "$ref": "#/$defs/toggle"
                },
                "input-modalities": {
                    "$ref": "#/$defs/toggle"
                },
                "readable": {
                    "$ref": "#/$defs/toggle"
                },
                "predictable": {
                    "$ref": "#/$defs/toggle"
                },
                "input-assistance": {
                    "$ref": "#/$defs/toggle"
                },
                "compatible": {
                    "$ref": "#/$defs/toggle"
                }
            }
        },

        "criteria": {
            "type": "object",
            "description": "Enable or disable individual WCAG success criteria.",
            "propertyNames": {
                "enum": [
                    "1.1.1",
                    "1.2.1", "1.2.2", "1.2.3",
                    "1.2.4", "1.2.5", "1.2.6",
                    "1.2.7", "1.2.8", "1.2.9",
                    "1.3.1", "1.3.2", "1.3.3",
                    "1.3.4", "1.3.5", "1.3.6",
                    "1.4.1", "1.4.2", "1.4.3",
                    "1.4.4", "1.4.5", "1.4.6",
                    "1.4.7", "1.4.8", "1.4.9",
                    "1.4.10", "1.4.11", "1.4.12",
                    "1.4.13",

                    "2.1.1", "2.1.2", "2.1.3",
                    "2.1.4",
                    "2.2.1", "2.2.2", "2.2.3",
                    "2.2.4", "2.2.5", "2.2.6",
                    "2.3.1", "2.3.2", "2.3.3",
                    "2.4.1", "2.4.2", "2.4.3",
                    "2.4.4", "2.4.5", "2.4.6",
                    "2.4.7", "2.4.8", "2.4.9",
                    "2.4.10", "2.4.11", "2.4.12",
                    "2.4.13",
                    "2.5.1", "2.5.2", "2.5.3",
                    "2.5.4", "2.5.5", "2.5.6",
                    "2.5.7", "2.5.8",

                    "3.1.1", "3.1.2", "3.1.3",
                    "3.1.4", "3.1.5", "3.1.6",
                    "3.2.1", "3.2.2", "3.2.3",
                    "3.2.4", "3.2.5", "3.2.6",
                    "3.3.1", "3.3.2", "3.3.3",
                    "3.3.4", "3.3.5", "3.3.6",
                    "3.3.7", "3.3.8", "3.3.9",

                    "4.1.2", "4.1.3"
                ]
            },
            "additionalProperties": {
                "$ref": "#/$defs/toggle"
            }
        },

        "rules": {
            "type": "object",
            "description": "Enable or disable individual control rules.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/toggle"
            }
        }
    },

    "$defs": {
        "toggle": {
            "type": "boolean",
            "default": true
        }
    }
}